{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pdf-realsid",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-09",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "routes": [
    {
      "pattern": "pdf.realsid08.me",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  },
  "account_id": "a948d7fb82122c0f6f00bec3a43585b1",
  "browser": {
    "binding": "BROWSER",
    "remote": true
  },
  "ratelimits": [
    {
      "name": "CONVERT_LIMITER",
      "namespace_id": "2026101201",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "version_metadata": {
    "binding": "VERSION"
  }
}
