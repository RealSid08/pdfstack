{
  "name": "pdfstack",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "build": "tsc -b && vite build && node scripts/prepare-notices.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "test": "node worker/verify-local.mjs && node worker/verify-worker.mjs"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.4.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "cfb": "^1.2.2",
    "fast-xml-parser": "^5.12.0",
    "fflate": "^0.8.3",
    "heic-to": "^1.6.7",
    "lucide-react": "^1.69.0",
    "mammoth": "^1.13.0",
    "marked": "^18.1.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "postal-mime": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "^2.18.1",
    "utif2": "^4.1.0",
    "word-extractor": "^1.0.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261106.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.2.1",
    "oxlint": "^1.91.0",
    "tailwindcss": "^4.3.4",
    "typescript": "~6.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.158.0"
  },
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=26 <27"
  },
  "license": "MIT",
  "description": "Stack: combine images, PDFs, and documents into one PDF with a stateless Cloudflare converter.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RealSid08/pdfstack.git"
  },
  "homepage": "https://stack.realsid08.me",
  "bugs": {
    "url": "https://github.com/RealSid08/pdfstack/issues"
  }
}
